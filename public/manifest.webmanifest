{
  "id": "./",
  "name": "PasteBox",
  "short_name": "PasteBox",
  "description": "Temporary file sharing with private, expiring links.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f8f7f4",
  "theme_color": "#f7f7f5",
  "icons": [{ "src": "./pastebox-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" }],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "file", "accept": ["*/*"] }] }
  }
}
